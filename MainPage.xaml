<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
  x:Class="GPSet.MainPage"
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  xmlns:mapsui="clr-namespace:Mapsui.UI.Maui;assembly=Mapsui.UI.Maui"
  Shell.NavBarIsVisible="False">
  <Grid BackgroundColor="#101418" RowDefinitions="*,Auto">
    <Grid IsClippedToBounds="True">
      <mapsui:MapView
        x:Name="MapView"
        IsMyLocationButtonVisible="False"
        IsNorthingButtonVisible="False"
        IsZoomButtonVisible="False" />
      <Label
        Margin="8,8,8,76"
        Padding="5,2"
        BackgroundColor="#BBFFFFFF"
        FontSize="10"
        HorizontalOptions="End"
        Text="Imagery © Google"
        TextColor="#202124"
        VerticalOptions="End" />
      <Grid
        x:Name="Crosshair"
        HeightRequest="48"
        HorizontalOptions="Center"
        InputTransparent="True"
        VerticalOptions="Center"
        WidthRequest="48">
        <BoxView
          HeightRequest="48"
          WidthRequest="2"
          Color="#F44336" />
        <BoxView
          HeightRequest="2"
          WidthRequest="48"
          Color="#F44336" />
        <Border
          HeightRequest="18"
          Stroke="#F44336"
          StrokeShape="RoundRectangle 9"
          StrokeThickness="2"
          WidthRequest="18" />
      </Grid>
      <Grid
        x:Name="RouteControls"
        Margin="16,12"
        Padding="8"
        BackgroundColor="#DD171C21"
        ColumnDefinitions="*,*,*"
        ColumnSpacing="8"
        IsVisible="False"
        VerticalOptions="End">
        <Button
          x:Name="PlayButton"
          BackgroundColor="#2E7D32"
          Clicked="OnPlayButtonClicked"
          CornerRadius="10"
          FontAttributes="Bold"
          IsVisible="False"
          Text="PLAY"
          TextColor="White" />
        <Button
          x:Name="SpeedButton"
          BackgroundColor="#6A1B9A"
          Clicked="OnSpeedButtonClicked"
          CornerRadius="10"
          FontAttributes="Bold"
          IsVisible="False"
          Text="Walking"
          TextColor="White" />
        <Button
          x:Name="StopButton"
          Grid.Column="1"
          Grid.ColumnSpan="2"
          BackgroundColor="#C62828"
          Clicked="OnStopButtonClicked"
          CornerRadius="10"
          FontAttributes="Bold"
          IsVisible="False"
          Text="STOP"
          TextColor="White" />
        <Button
          x:Name="UndoButton"
          Grid.Column="1"
          BackgroundColor="#455A64"
          Clicked="OnUndoButtonClicked"
          CornerRadius="10"
          FontAttributes="Bold"
          IsVisible="False"
          Text="UNDO"
          TextColor="White" />
        <Button
          x:Name="WaypointButton"
          Grid.Column="2"
          BackgroundColor="#1565C0"
          Clicked="OnWaypointButtonClicked"
          CornerRadius="10"
          FontAttributes="Bold"
          Text="WAYPOINT"
          TextColor="White" />
      </Grid>
    </Grid>
    <Grid
      Grid.Row="1"
      Padding="16,12,16,18"
      BackgroundColor="#171C21"
      ColumnDefinitions="*,Auto"
      ColumnSpacing="14">
      <VerticalStackLayout Spacing="2" VerticalOptions="Center">
        <Label
          FontSize="10"
          Text="SELECTED POSITION"
          TextColor="#8FA1B2" />
        <Label
          x:Name="CoordinatesLabel"
          FontAttributes="Bold"
          FontSize="15"
          Text="--"
          TextColor="White" />
      </VerticalStackLayout>
      <Button
        x:Name="SimulationButton"
        Grid.Column="1"
        BackgroundColor="#2E7D32"
        Clicked="OnSimulationButtonClicked"
        CornerRadius="12"
        FontAttributes="Bold"
        HeightRequest="52"
        Text="Simulate"
        TextColor="White"
        WidthRequest="120" />
    </Grid>
  </Grid>
</ContentPage>
